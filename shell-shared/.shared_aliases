# Custom git-related command to archive repos
garc() {
  # --- Git Root Guard Clause ---
  if [ ! -e ".git" ]; then
    printf '%s\n' "⚠️  Oops! You are not at the root of a Git repository."
    printf '%s\n' "Please navigate to your project's root folder (where the .git folder is)."
    return 1
  fi

  # Initialize variables
  # Note: Using "local" works with bash/zsh, but it's not strictly POSIX-compliant.
  # If we ever need it to be fully POSIX-compliant (e.g. for using it in Alpine Linux or other non-typical shells),
  # we can either manually unset variables before each return call (which is a hassle),
  # or use a subshell to contain variable scope by declaring the function with parentheses: like garc() () instead of garc () {}, which is better but a bit less performant since it needs to spawn a subshell every time this is called.
  local name include_git include_date force name_override output_path

  # Set default values
  name="${PWD##*/}" # ${PWD##*/} grabs the current directory name
  include_git=0
  include_date=0
  force=0
  name_override=""

  # --- Argument Parsing ---
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -g|--include-git) include_git=1; shift ;;
      -d|--include-date) include_date=1; shift ;;
      -f|--force) force=1; shift ;;
      -*) 
        printf '%s\n' "Unknown option: $1"
        return 1 
        ;;
      *) 
        name_override="$1"
        shift 
        ;;
    esac
  done

  # If a custom name was provided, use it
  if [ -n "$name_override" ]; then
    name="$name_override"
  fi

  # Strip .zip if you manually typed it (using POSIX parameter expansion)
  name="${name%.zip}"

  # Prepend today's date (format: YYYYMMDD) if the flag is present
  if [ "$include_date" -eq 1 ]; then
    name="$(date +%Y%m%d)-$name"
  fi

  # Guarantee it has the .zip extension
  name="${name}.zip"

  # If you didn't specify a path (no slashes), put it safely in the parent directory
  case "$name" in
    */*) output_path="$name" ;;
    *)   output_path="../$name" ;;
  esac

  # --- Overwrite Safety Check ---
  if [ -e "$output_path" ]; then
    if [ "$force" -eq 1 ]; then
      printf '%s\n' "🗑️  Removing existing archive..."
      rm -f "$output_path"
    else
      printf '%s\n' "⚠️  An archive named '$output_path' already exists!"
      printf '%s\n' "Use the -f or --force flag if you want to overwrite it."
      return 1
    fi
  fi

  if [ "$include_git" -eq 1 ]; then
    # Guard clause: Check if zip is installed
    if ! command -v zip >/dev/null 2>&1; then
        printf '%s\n' "⚠️  Oops! The 'zip' command was not found."
        printf '%s\n' "You can install it via: sudo apt install zip"
        return 1
    fi

    printf '%s\n' "📦 Creating time-capsule archive (with Git history) at $output_path..."

    # FIX: -c core.quotePath=false forces Git to output raw UTF-8 accents, and the -UN=UTF8 flag tells zip to expect UTF-8 input.
    # The -nw flag prevents zip from adding extra directory info, and the -q flag makes it run quietly.
    
    {
        # --- SUBMODULE FIX ---
        if [ -f ".gitmodules" ]; then
            # Extract submodule paths (safely slicing everything after the first space to support spaces in paths)
            local sub_paths
            sub_paths=$(git config --file .gitmodules --get-regexp path 2>/dev/null | sed 's/^[^ ]* //')
            
            if [ -n "$sub_paths" ]; then
                # Remove the submodule root folders from the parent list so zip doesn't handle them blindly
                # grep -vxF filters out exact line matches found in $sub_paths
                git -c core.quotePath=false ls-files --cached --others --exclude-standard | grep -vxF "$sub_paths"
                
                # Ask each submodule for its own clean list of files (respecting its .gitignore)
                printf "%s\n" "$sub_paths" | while IFS= read -r sub; do
                    [ -z "$sub" ] && continue
                    
                    if [ -e "$sub/.git" ]; then
                        # Get files by running Git "inside" the submodule and prefix them with the submodule path
                        git -C "$sub" -c core.quotePath=false ls-files --cached --others --exclude-standard | sed "s|^|$sub/|"
                        
                        # Critical! Manually add the submodule's .git pointer file
                        # If we don't include it, the reference will break upon extraction
                        printf '%s\n' "$sub/.git"
                    fi
                done
            else
                git -c core.quotePath=false ls-files --cached --others --exclude-standard
            fi
        else
            # Standard repo without submodules
            git -c core.quotePath=false ls-files --cached --others --exclude-standard
        fi
        # ---------------------

        # Finally, include the parent repo's git history
        find .git -type f
    } | zip -UN=UTF8 -nw -q "$output_path" -@

    if [ $? -eq 0 ]; then
        printf '%s\n' "✅ Success! Archive ready outside the repo at $output_path"
    else
        printf '%s\n' "❌ Zip command failed. Check your permissions."
    fi

  else
    printf '%s\n' "⚡ Creating pure code snapshot (no history) at $output_path..."

    if git archive --format=zip HEAD -o "$output_path"; then
        printf '%s\n' "✅ Success! Archive ready outside the repo at $output_path"
    else
        printf '%s\n' "❌ git archive failed. Are you sure this repository has at least one commit?"
    fi
  fi
}