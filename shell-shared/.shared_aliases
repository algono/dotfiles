# Dotfiles management
DOTFILES_DIR=~/dotfiles

# dotfiles stow function
dotfiles ()
{
  args=""
  packages=""

  while [ $# -gt 0 ]; do
    case "$1" in
      -a|--all)
        shift
        packages="$(find "$DOTFILES_DIR"/* -maxdepth 1 -name ".*" -o -type d -prune -printf "%f\n")"
        ;;
      -r|--rebuild)
        shift
        # Re-using the find logic here
        packages="$(find "$DOTFILES_DIR"/* -maxdepth 1 -name ".*" -o -type d -prune -printf "%f\n")"
        if [ -f /etc/skel/.bashrc ]; then
          now="$(date -Iseconds)"
          cp -f ~/dotfiles/bash/.bashrc ~/.bashrc-"$now".bak
          rm -f ~/.bashrc
          cp -f /etc/skel/.bashrc ~/dotfiles/bash/.bashrc
          ed ~/dotfiles/bash/.bashrc < ~/dotfiles/.patches/bashrc-patch.ed
          tput setaf 10; echo "################################################################"
          echo "~/.bashrc was successfully rebuilt. Backup: ~/.bashrc-$now.bak"
          echo "################################################################"; tput sgr0
        else
          tput setaf 11; echo "################################################################"
          echo "WARNING: ~/.bashrc could not be rebuilt."
          echo "################################################################"
          echo ; tput sgr0
        fi
        args="$args -R"
        ;;
      *)
        args="$args $1"
        shift
        ;;
    esac
  done

  # Using printf/xargs combo to handle potential spaces
  printf "%s %s" "$args" "$packages" | xargs /usr/bin/stow -d "$DOTFILES_DIR" -t ~

  # Unset variables to avoid polluting the shell environment
  # NOTE: If we ever need to return early from this function,
  # we should instead either use local variables (losing 100% POSIX compliance) or a subshell (losing a bit of performance due to the extra process)
  unset args packages now
}
